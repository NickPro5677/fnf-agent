# Copia y exporta lo que necesites. Los scripts no cargan este archivo solos.

# Partida
FNF_SONG=primer-paso          # primer-paso | luz-de-neon | test | nombre de env/charts/<n>-chart.json
FNF_DIFF=0                 # 0 easy · 1 normal · 2 hard
FNF_SCALE=                 # vacío = auto (minGap/450). 0.25 lento, 1 tiempo real
FNF_SIDES=player           # player = solo d 0-3 · both = todas jugables
FNF_AGENT=chart            # chart | observe

# Motor
FNF_FPS=15                 # 8–30
# FNF_HIT_Y=560
# FNF_SOCK=env/run/engine.sock
# FNF_CHARTS_DIR=env/charts
# FNF_RENDER_DIR=env/render
# FNF_RUN_DIR=env/run

# Agente observe
# FNF_PRESS_MS=50

# Visor
FNF_WEB_HOST=127.0.0.1     # 0.0.0.0 para LAN
FNF_WEB_PORT=8787
# FNF_WEB_TOKEN=             # si se define, POST exige X-Fnf-Token
